# Used by docker-compose for variable substitution.
# Copy to .env and fill in real values. .env is gitignored.

# Root admin — used by the mongo image for its initial bootstrap and by the
# nightly mongodump backup.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
MONGO_INITDB_DATABASE=suumo

# Application user — read/write on the suumo DB only. Created by
# mongodb/init/01-create-app-user.sh on a virgin data volume.
MONGO_APP_USERNAME=suumo_app
MONGO_APP_PASSWORD=CHANGE_ME_APP

# Root URI (mongodump). Username must match MONGO_INITDB_ROOT_USERNAME.
MONGO_URI_ROOT=mongodb://admin:CHANGE_ME@mongodb:27017/?authSource=admin

# Application URI (scraper + CLI). Username must match MONGO_APP_USERNAME and
# authSource is the app database itself.
MONGO_URI_APP=mongodb://suumo_app:CHANGE_ME_APP@mongodb:27017/?authSource=suumo

MONGO_DB_NAME=suumo
MONGO_COLLECTION_NAME=listings
MONGO_COLLECTION_DETAILS=details
MONGO_COLLECTION_STATE=scraper_state

SCRAPE_MODE=DETAIL
STORE_HTML=true
MAX_REQ_PER_MINUTE=30
