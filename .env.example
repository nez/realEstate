# Used by docker-compose for variable substitution.
# Copy to .env and fill in real values. .env is gitignored.

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
MONGO_INITDB_DATABASE=suumo

# Composed from the above; the scraper container reads this directly.
MONGO_URI=mongodb://admin:CHANGE_ME@mongodb:27017/?authSource=admin
MONGO_DB_NAME=suumo
MONGO_COLLECTION_NAME=listings
MONGO_COLLECTION_DETAILS=details
MONGO_COLLECTION_STATE=scraper_state

SCRAPE_MODE=DETAIL
STORE_HTML=true
