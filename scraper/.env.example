# DB
# For dev/CLI use, point this at the least-privilege app user (authSource=suumo).
# The mongo root user is reserved for backups and one-time admin tasks.
MONGO_URI='mongodb://suumo_app:CHANGE_ME_APP@localhost:27017/?authSource=suumo'
MONGO_DB_NAME='suumo'
MONGO_COLLECTION_NAME='listings'
MONGO_COLLECTION_DETAILS='details'
MONGO_COLLECTION_STATE='scraper_state'

# Suumo. ar=030 covers the entire Kanto region (Tokyo + Kanagawa + Saitama +
# Chiba + Ibaraki + Tochigi + Gunma — ~170k listings, ~5700 pages). Narrow to a
# single prefecture by adding ta=NN (13=Tokyo, 14=Kanagawa, 11=Saitama, 12=Chiba).
#
# All Japan: set START_PATHS instead (semicolon-separated, one URL per ar code).
# Each URL gets its own resume marker so crashes resume cleanly per region.
# Combined: ~447k listings, ~14.9k pages, ~8.3h at 30 req/min.
# ar codes: 010 北海道, 020 東北, 030 関東, 040 甲信越・北陸, 050 東海,
#           060 関西, 070 四国, 080 中国, 090 九州・沖縄.
START_PATH='https://suumo.jp/jj/common/ichiran/JJ901FC004/?ar=030&kwd=&bs=010&bs=011&bs=020&bs=021&bs=030&cb=0.0&ct=9999999&kb=0&kt=9999999&km=1&xb=0&xt=9999999&et=9999999&cn=9999999&newflg=0'
# START_PATHS='url1;url2;...;url9'
BASE_PATH='https://suumo.jp'

# Scraper
SCRAPE_MODE='LISTING'    # LISTING or DETAIL
STORE_HTML='true'        # Set to 'false' once parser coverage is verified to stop storing full HTML in each detail document.
MAX_REQ_PER_MINUTE='30'  # Global politeness budget. Applies across listing and detail HTTP requests.

# Cron (used by k8s CronJob schedule, not by the app itself)
CRON_SCHEDULE='00 23 * * *'
