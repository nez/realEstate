# DB
# For dev/CLI use, point this at the least-privilege app user (authSource=suumo).
# The mongo root user is reserved for backups and one-time admin tasks.
MONGO_URI='mongodb://suumo_app:CHANGE_ME_APP@localhost:27017/?authSource=suumo'
MONGO_DB_NAME='suumo'
MONGO_COLLECTION_NAME='listings'
MONGO_COLLECTION_DETAILS='details'
MONGO_COLLECTION_STATE='scraper_state'

# Suumo
START_PATH='https://suumo.jp/jj/common/ichiran/JJ901FC004/?ar=030&ta=13&kwd=&bs=010&bs=011&bs=020&bs=021&bs=030&cb=0.0&ct=9999999&kb=0&kt=9999999&km=1&xb=0&xt=9999999&et=9999999&cn=9999999&newflg=0'
BASE_PATH='https://suumo.jp'

# Scraper
SCRAPE_MODE='LISTING'    # LISTING or DETAIL
STORE_HTML='true'        # Set to 'false' once parser coverage is verified to stop storing full HTML in each detail document.
MAX_REQ_PER_MINUTE='30'  # Global politeness budget. Applies across listing and detail HTTP requests.

# Cron (used by k8s CronJob schedule, not by the app itself)
CRON_SCHEDULE='00 23 * * *'
